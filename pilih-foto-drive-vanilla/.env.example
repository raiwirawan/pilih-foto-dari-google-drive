# Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env

# API key Google Cloud (Drive API sudah diaktifkan)
GOOGLE_API_KEY=

# ID folder Drive (bagian terakhir dari link folder). Folder harus "Siapa saja yang memiliki link" (Viewer)
DRIVE_FOLDER_ID=

# Nama klien yang tampil di halaman
CLIENT_NAME=Klien

# Nomor WhatsApp editor, format 628xxxxxxxxxx (kosongkan jika ingin pilih kontak sendiri)
EDITOR_WA=

PORT=3000
